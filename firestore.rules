rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    function isAdmin() {
      return isAuth() && getUserRole(request.auth.uid) == 'admin';
    }

    function isTrainer() {
       return isAuth() && getUserRole(request.auth.uid) == 'trainer';
    }

    // User Collection
    match /users/{userId} {
      allow read: if isAuth() && (isOwner(userId) || isAdmin() || isTrainer());
      allow create: if isAuth() && isAdmin();
      allow update: if isAuth() && (isOwner(userId) || isAdmin());
      allow delete: if isAuth() && isAdmin();
    }

    // User Subcollections (e.g., Payments, membershipHistory)
    match /users/{userId}/{collection}/{docId} {
      allow read, write: if isAuth() && (isOwner(userId) || isAdmin());
    }

    // Membership Plans
    match /membershipPlans/{planId} {
      allow read: if isAuth();
      allow write: if isAuth() && isAdmin();
    }

    // Attendance Records (legacy structure)
    match /attendance/{date}/records/{userId} {
      allow read, write: if isAuth() && (isAdmin() || isTrainer());
    }

    // Attendance Logs
    match /attendance_logs/{date}/records/{recordId} {
      allow read: if isAuth();
      allow create, update: if isAuth() && (isAdmin() || isTrainer());
      allow delete: if isAuth() && isAdmin();
    }

    // Payment Records
    match /payments/{paymentId} {
      allow read: if isAuth() && isAdmin();
      allow create, update: if isAuth() && isAdmin();
      allow delete: if isAuth() && isAdmin();
    }

    // Stats collection - FIXED
    match /stats/{document} {
      allow read: if isAuth() && isAdmin();
      allow write: if isAuth() && isAdmin();
    }

    // System collection - NEW (for biometric counter)
    match /system/{document} {
      allow read: if isAuth() && isAdmin();
      allow write: if isAuth() && isAdmin();
    }

    // Settings collection - for gym settings
    match /settings/{document} {
      allow read: if isAuth();
      allow write: if isAuth() && isAdmin();
    }
  }
}
